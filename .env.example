# 修复 Agent 环境变量示例
# 用法：复制为 .env 后填写，或直接在 shell 里 export。
# 注意 .env 已在 .gitignore 中，切勿把真实密钥提交到仓库。

# ---- 修复引擎 ----
# rules：规则级修补器（默认，只用标准库，每处改写都过自检）
# llm：模型整文件重写（**仍要过同一套自检**，过不了就不落地）
FIX_ENGINE=rules

# ---- 门禁口径（必须与审查 Agent 一致）----
# 用它判断"我这次的改写有没有引入新的阻断级问题"
FIX_BLOCKING=critical,high

# ---- 改写范围 ----
# 单次最多处理多少条发现
FIX_MAX_FIXES=80
# 只处理这些规则（逗号分隔，留空表示全部）
# FIX_ONLY_RULES=CG106,CG105
# 跳过这些规则
# FIX_SKIP_RULES=CG402,CG403
# 只做语法检查、不做规则级自检（不建议关闭）
FIX_VERIFY=1
# 只试运行不写文件
FIX_DRY_RUN=0
# 写回前把原文件备份到 .fix_backup/
FIX_KEEP_BACKUP=0

# ---- codeguard 定位（用于权威自检，一般不需要填）----
# 找不到 codeguard 时会降级为内置计数器，并在报告里明确说明
# FIX_CODEGUARD_PATH=../codeguard

# ---- LLM（engine=llm 时必填）----
FIX_API_KEY=sk-替换成你自己的key
FIX_BASE_URL=https://api.deepseek.com
FIX_MODEL=deepseek-chat
